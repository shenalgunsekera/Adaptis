rules_version = '2';

/* ============================================================================
   Storage security rules.

   Site imagery is public to read, because the pages that use it are public.
   Writing is restricted to signed-in accounts, and the upload is additionally
   constrained by type and size so an authenticated account cannot be used to
   park arbitrary files in the bucket.

   Firebase Auth alone does not mean "may edit the site": the allowlist check
   happens server side on every content write. These rules are the second
   layer, not the only one.
   ========================================================================= */

service firebase.storage {
  match /b/{bucket}/o {

    match /site/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|avif|svg\\+xml)');

      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
