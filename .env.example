# =============================================================================
# Adaptis website — environment
#
# Copy to .env.local for development. In production set the same names in the
# Vercel project under Settings, Environment Variables.
#
# Nothing in this file is a real credential. Never commit .env.local.
# =============================================================================

# --- Firebase Admin, server side ---------------------------------------------
# The project is always needed. How the server proves who it is has three
# possible answers; fill in ONE of the three blocks below.
# `npm run firebase:check` reports which one is in effect and whether it works.
FIREBASE_PROJECT_ID=adaptis-website

# 1. A service account key.
#    Firebase console: Project settings, Service accounts, "Generate new
#    private key". Two values come out of that JSON file.
#
#    Many organizations block this outright with the
#    iam.disableServiceAccountKeyCreation policy, because a downloaded key is
#    a long-lived secret that leaks. If "Generate new private key" fails, use
#    block 2 or 3 instead; neither involves a key.
#
#    The private key contains newlines. Paste it with the \n sequences intact
#    and wrapped in double quotes; the app normalises both forms.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@adaptis-website.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# 2. Workload identity federation. No key, and the route for production on
#    Vercel when keys are blocked. Vercel signs a short-lived OIDC token per
#    deployment and Google trades it for an access token. Turn on Secure
#    Backend Access in the Vercel project so VERCEL_OIDC_TOKEN is injected.
#    Setup is in docs/SETUP.md section 2.
# GCP_WORKLOAD_IDENTITY_AUDIENCE=//iam.googleapis.com/projects/000000000000/locations/global/workloadIdentityPools/vercel/providers/vercel
# GCP_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@adaptis-website.iam.gserviceaccount.com

# 3. Application default credentials. No key, and the quickest way to work
#    locally. Nothing goes in this file; you sign in once with the gcloud CLI:
#      gcloud auth application-default login
#      gcloud auth application-default set-quota-project <project-id>
#    Cloud Run, Cloud Functions and App Engine provide this ambiently.

# --- Firebase, browser side ---------------------------------------------------
# From the Firebase console: Project settings, General, your web app.
# These are public by design and safe to expose; access is controlled by the
# security rules and by the allowlist below, not by hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adaptis-website.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adaptis-website
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=adaptis-website.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics measurement id. Nothing reads it: the site counts views
# itself, without cookies or identifiers. Switching on Firebase Analytics
# would set cookies and require a consent banner. See docs/SETUP.md, 9.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Who may edit the site -----------------------------------------------------
# Comma-separated. An account must exist in Firebase Auth AND be listed here.
# Held in the environment rather than the database on purpose: an attacker who
# reaches Firestore must not be able to add themselves.
ADMIN_EMAILS=connect@adaptis.ca,sheida@adaptis.ca

# --- Enquiry notifications, over Gmail -----------------------------------------
# SMTP_PASS must be a 16-character Google app password, not the account
# password: Gmail rejects account passwords for SMTP. Generate one at
# myaccount.google.com, Security, App passwords, once two-step verification is
# on. It can be revoked there at any time without changing the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=connect@adaptis.ca
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=connect@adaptis.ca
