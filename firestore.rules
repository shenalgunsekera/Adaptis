rules_version = '2';

/* ============================================================================
   Firestore security rules.

   Every read and write this application performs goes through the Firebase
   Admin SDK on the server, and the Admin SDK bypasses these rules entirely.
   These rules therefore govern one thing only: what a browser holding the
   public API key can do by talking to Firestore directly.

   The answer is nothing. The public site is server-rendered, so the browser
   never needs to read content; the admin panel posts to this application's
   own API routes, which check a signed session cookie before touching the
   database. Nothing in the browser has, or needs, direct database access.

   That matters most for `adminUsers`. It holds password hashes. Even scrypt
   hashes must never be readable by a browser: a readable hash is an offline
   cracking target, and the rule below is what keeps it off the wire.

   After editing this file: Firebase console, Firestore Database, Rules,
   paste, Publish.
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    // Editor accounts and password hashes. Read or written only by the
    // server, through the Admin SDK, after a session check.
    match /adminUsers/{account} {
      allow read, write: if false;
    }

    // Site content. Server-rendered through the Admin SDK; no client access.
    match /pages/{page} {
      allow read, write: if false;
    }

    match /settings/{doc} {
      allow read, write: if false;
    }

    // Enquiries. Written by the contact API with the Admin SDK, read in the
    // admin panel through an authenticated API route. Never from a browser:
    // a client-writable collection here would be an open spam relay, and a
    // client-readable one would publish everyone who ever made contact.
    match /contactSubmissions/{submission} {
      allow read, write: if false;
    }

    // Daily view and enquiry counters. Written by /api/track, which validates
    // the path against the known page list before incrementing. Client-side
    // writes would let anyone inflate the figures.
    match /analytics/{day} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
